{
	"name" : "cobbyio/cobby-connector-magento2",
	"description" : "This extension for Magento 2 provides a direct integration of the cobby management methods to your Magento 2 shop.",
	"version" : "2.4.16",
	"type" : "magento2-module",
	"require": {
		"magento/framework": "^102.0|^103.0|^104.0",
		"php": "^8.0|^7.0"
	},
	"license" : "OSL-3.0",
	"autoload" : {
		"files" : [
			"registration.php"
		],
		"psr-4" : {
			"Cobby\\Connector\\" : ""
		}
	},
	"authors" : [{
			"name" : "cobby",
			"email" : "info@cobby.io"
		}
	],
	"require-dev": {
		"magento/magento-coding-standard": "^41",
		"phpstan/phpstan": "^2.1",
		"bitexpert/phpstan-magento": "^0.44",
		"phpstan/extension-installer": "^1.4"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		}
	}
}
